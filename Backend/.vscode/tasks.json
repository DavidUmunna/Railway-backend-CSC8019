{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Spring Boot Backend",
			"type": "shell",
			"command": "mvnw.cmd",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true
		},
		{
			"label": "Fix Maven Wrapper Jar",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Invoke-WebRequest -Uri \"https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.4/maven-wrapper-3.3.4.jar\" -OutFile \".mvn/wrapper/maven-wrapper.jar\""
			],
			"isBackground": false
		},
		{
			"label": "Run Spring Boot Backend",
			"type": "shell",
			"command": "mvnw.cmd",
			"args": [
				"spring-boot:run"
			],
			"isBackground": true
		}
	]
}